{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operon-connect-website",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "directory": "dist",
  },
}
