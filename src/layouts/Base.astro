---
import { getLocaleFromUrl, getLocaleMetadata, getAllLocales } from '../i18n/index';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = new URL('/operon-icon.svg', Astro.site).href,
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const localeMetadata = getLocaleMetadata(locale);
const fullTitle = title.includes('Operon Connect') ? title : `${title} | Operon Connect`;

// Generate hreflang URLs
const getLocalizedUrl = (loc: string) => {
  let path = Astro.url.pathname;
  const match = path.match(/^\/([a-z]{2})(?:\/|$)/);
  if (match) {
    path = path.slice(match[0].length - 1) || '/';
  }

  const baseUrl = new URL(Astro.url).origin;
  if (loc === 'en') {
    return `${baseUrl}${path}`;
  }
  return `${baseUrl}/${loc}${path}`;
};

const hreflangUrls = getAllLocales().map((loc) => ({
  lang: loc,
  href: getLocalizedUrl(loc),
}));

const hreflangTag = (loc: string) => (loc === 'my' ? 'my-MM' : 'en');

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<!-- lang matches translations.lang so :lang(my) rules in global.css apply -->
<html lang={localeMetadata.lang} dir={localeMetadata.dir} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Theme: default = navy (no class). localStorage 'dark' = user chose light palette (html.dark). -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Operon Connect" />
    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <meta name="robots" content="index,follow,max-image-preview:large" />
      )
    }
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }
    <link rel="canonical" href={canonical} />

    <!-- hreflang for localization SEO -->
    {
      hreflangUrls.map((link) => (
        <link rel="alternate" hreflang={hreflangTag(link.lang)} href={link.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getLocalizedUrl('en')} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Operon Connect" />
    <meta property="og:locale" content={localeMetadata.locale} />
    {
      hreflangUrls
        .filter((l) => l.lang !== locale)
        .map((link) => (
          <meta property="og:locale:alternate" content={link.lang === 'my' ? 'my_MM' : 'en_US'} />
        ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Noto+Sans+Myanmar:wght@300;400;700&family=JetBrains+Mono:wght@400;600&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <link rel="stylesheet" href="/styles/global.css" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline src="/scripts/main.js" defer></script>
  </body>
</html>
