---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/index';

const locale = 'en';
const translations = getTranslations(locale);
const about = translations.about;
const bf = 'font-body';
---

<Base title={about.pageTitle} description={about.pageDesc}>
  <Nav />

  <section
    class="relative z-10"
    style="padding-top:clamp(96px,18vh,160px);padding-bottom:clamp(48px,8vw,80px)"
  >
    <div class="mx-auto w-full max-w-[1200px] px-[5%]">
      <span
        class="mb-4 block font-mono text-[11px] tracking-[.15em] text-[color:var(--brand-cyan)]"
      >
        {about.tag.replace('// ', '')}
      </span>
      <h1 class="display-hero-about mb-16 font-display leading-none text-[color:var(--white)]">
        {about.headline}
      </h1>

      <div class="grid grid-cols-1 gap-0 lg:grid-cols-[1fr_1px_1fr]">
        <div class="pb-10 pr-0 lg:pb-0 lg:pr-14">
          <h2 class="mb-5 font-mono text-[11px] tracking-[.15em] text-[color:var(--brand-cyan)]">
            {about.mission.title}
          </h2>
          <p
            class={`${bf} text-[color:var(--muted)] leading-relaxed text-sm`}
            style="font-size:clamp(14px,2vw,16px)"
          >
            {about.mission.description}
          </p>
        </div>
        <div class="hidden bg-[color:var(--border-card)] lg:block"></div>
        <div class="mb-10 h-px bg-[color:var(--border-card)] lg:hidden"></div>
        <div class="pl-0 lg:pl-14">
          <h2 class="mb-5 font-mono text-[11px] tracking-[.15em] text-[color:var(--brand-cyan)]">
            {about.vision.title}
          </h2>
          <p
            class={`${bf} text-[color:var(--muted)] leading-relaxed text-sm`}
            style="font-size:clamp(14px,2vw,16px)"
          >
            {about.vision.description}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-10 py-12 md:py-16" style="background:var(--navy2)">
    <div class="reveal mx-auto w-full max-w-[1200px] px-[5%]">
      <h2 class="section-title mb-10 font-display text-[color:var(--white)]">
        {about.valuesTitle}
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6">
        {
          about.values.map((v) => (
            <div class="rounded-xl border border-[color:var(--border-card)] bg-[color:var(--navy3)] p-6">
              <span class="font-mono text-xs tracking-widest text-[color:var(--brand-cyan)]">
                {v.number}
              </span>
              <h3 class="mb-3 mt-2 text-lg font-bold text-[color:var(--white)]">{v.title}</h3>
              <p class={`${bf} text-sm leading-relaxed text-[color:var(--muted)]`}>
                {v.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Base>
