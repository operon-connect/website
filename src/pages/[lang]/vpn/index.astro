---
import Base from '../../../layouts/Base.astro';
import VpnPageContent from '../../../components/VpnPageContent.astro';
import { getTranslations, getAllLocales } from '../../../i18n/index';
import type { Locale } from '../../../i18n/index';
import { buildVpnJsonLd } from '../../../i18n/vpn-schemas';

export function getStaticPaths() {
  return getAllLocales()
    .filter((locale: string) => locale !== 'my')
    .map((locale: string) => ({
      params: { lang: locale },
    }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const translations = getTranslations(locale);
const { vpnSchema, faqSchema } = buildVpnJsonLd(translations.vpn);
---

<Base title={translations.vpn.pageTitle} description={translations.vpn.pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(vpnSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <VpnPageContent locale={locale} />
</Base>
