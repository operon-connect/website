---
import { getLocaleFromUrl, getAllLocales, isValidLocale, localePath } from '../i18n/index';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const currentLocale = getLocaleFromUrl(pathname);
const locales = getAllLocales();

const getLocalizedPath = (locale: string) => {
  let path = pathname;
  const localeMatch = pathname.match(/^\/([a-z]{2})(\/.*)?$/);

  if (localeMatch && isValidLocale(localeMatch[1])) {
    path = localeMatch[2] || '/';
  }

  if (!path.startsWith('/')) path = '/' + path;

  return localePath(locale as 'en' | 'my', path);
};

const segBase =
  'inline-flex min-h-9 min-w-[2.75rem] items-center justify-center rounded-md px-2.5 font-mono text-[11px] font-medium tracking-[0.14em] no-underline transition-colors sm:px-3';
const segIdle =
  'text-[color:var(--muted)] transition-colors duration-200 hover:bg-white/[0.04] hover:text-[color:var(--white)] dark:hover:bg-black/[0.06]';
const segActive = 'bg-[color:var(--nav-active-bg)] text-[color:var(--nav-active-fg)]';
---

<div
  class="inline-flex shrink-0 items-center overflow-hidden rounded-lg border border-[color:var(--border-default)] bg-white/[0.04] p-0.5 dark:bg-black/[0.04]"
  role="group"
  aria-label="Language"
>
  {
    locales.map((loc) => (
      <a
        href={getLocalizedPath(loc)}
        class:list={[segBase, currentLocale === loc ? segActive : segIdle]}
        aria-current={currentLocale === loc ? 'true' : undefined}
      >
        {loc === 'my' ? 'MY' : 'EN'}
      </a>
    ))
  }
</div>
