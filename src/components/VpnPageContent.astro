---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/index';
import { getTranslations } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translations = getTranslations(locale);
const vpn = translations.vpn;
const bodyFont = locale === 'my' ? 'var(--myanmar)' : 'var(--body)';
---

<div class="vpn-page">
  <Nav />

  <!-- Hero -->
  <section class="section section-hero-vpn" aria-label="Hero">
    <div class="container">
      <div style="max-width:720px">
        <h1 class="display-hero-vpn">
          <span style="display:block;color:var(--white)">{vpn.hero.headline1}</span>
          <span style="display:block;-webkit-text-stroke:2px #00C2FF;color:transparent">{vpn.hero.headline2}</span>
          <span style="display:block;color:var(--white)">{vpn.hero.headline3}</span>
        </h1>
        <p style={`font-family:${bodyFont};font-size:clamp(15px,2.5vw,20px);color:var(--muted);margin-bottom:12px;line-height:1.9;max-width:560px`}>
          {vpn.hero.tagline}
        </p>
        <p style={`font-family:${bodyFont};font-size:clamp(14px,2vw,17px);color:var(--muted);margin-bottom:48px;line-height:1.7;max-width:560px`}>
          {vpn.hero.taglineSub}
        </p>
        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <a href="https://t.me/OperonConnectBot" class="btn-primary" target="_blank" rel="noopener">
            {vpn.hero.ctaPrimary}
          </a>
          <a href="#plans" class="btn-ghost">{vpn.hero.ctaSecondary}</a>
        </div>
        <div style="display:flex;gap:40px;flex-wrap:wrap;margin-top:56px">
          {vpn.hero.stats.map((s) => (
            <div>
              <div style="font-family:var(--display);font-size:40px;color:#00C2FF;line-height:1">{s.n}</div>
              <div style="font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:.08em;margin-top:4px">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="how-title">
    <div class="container reveal">
      <span class="tag">{vpn.howItWorks.tag}</span>
      <h2 class="section-title" id="how-title">{vpn.howItWorks.title}</h2>
      <p class="section-sub" style={`font-family:${bodyFont}`}>{vpn.howItWorks.subtitle}</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:rgba(0,194,255,.08)">
        {vpn.howItWorks.steps.map((s) => (
          <div style="background:var(--navy2);padding:40px 32px;position:relative;transition:.3s">
            <div style="font-family:var(--mono);font-size:48px;color:rgba(0,194,255,.08);font-weight:600;line-height:1;margin-bottom:24px">{s.n}</div>
            <h3 class="vpn-step-title">{s.title}</h3>
            <p style={`font-family:${bodyFont};font-size:14px;color:var(--muted);line-height:1.7`}>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section class="section" id="plans" aria-labelledby="plans-title">
    <div class="container reveal">
      <span class="tag">{vpn.pricing.tag}</span>
      <h2 class="section-title" id="plans-title">{vpn.pricing.title}</h2>
      <p class="section-sub" style={`font-family:${bodyFont}`}>{vpn.pricing.subtitle}</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
        {vpn.pricing.plans.map((p) => {
          const isPh = 'placeholder' in p && p.placeholder;
          const isContact = 'contactOnly' in p && (p as { contactOnly?: boolean }).contactOnly;
          const contactHref = isContact ? (p as { contactHref?: string }).contactHref ?? '#' : '';
          const contactCta = isContact ? (p as { contactCta?: string }).contactCta ?? '' : '';
          return (
            <div
              style={
                isPh
                  ? 'border:1px dashed rgba(0,194,255,.28);background:var(--navy2);padding:36px;position:relative;opacity:.88'
                  : isContact
                    ? 'border:1px solid rgba(0,194,255,.4);background:var(--navy3);padding:36px;position:relative'
                    : `border:1px solid ${p.featured ? '#00C2FF' : 'var(--border-soft)'};background:${p.featured ? 'var(--navy3)' : 'var(--navy2)'};padding:36px;position:relative`
              }
            >
              {isPh ? (
                <div style="position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--navy2);color:var(--muted);border:1px solid rgba(0,194,255,.35);font-family:var(--mono);font-size:9px;letter-spacing:.12em;font-weight:700;padding:4px 16px;white-space:nowrap">
                  {vpn.pricing.placeholderBadge}
                </div>
              ) : isContact ? (
                <div style="position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:rgba(0,194,255,.15);color:#00C2FF;border:1px solid rgba(0,194,255,.45);font-family:var(--mono);font-size:9px;letter-spacing:.12em;font-weight:700;padding:4px 16px;white-space:nowrap">
                  {'contactBadge' in vpn.pricing ? (vpn.pricing as { contactBadge: string }).contactBadge : 'CONTACT'}
                </div>
              ) : p.featured ? (
                <div style="position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:#00C2FF;color:var(--navy);font-family:var(--mono);font-size:9px;letter-spacing:.12em;font-weight:700;padding:4px 16px;white-space:nowrap">
                  {vpn.pricing.popularBadge}
                </div>
              ) : null}
              <div style="font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--muted);margin-bottom:12px">{p.tier}</div>
              <div class:list={['vpn-price-display', { 'vpn-price-placeholder': isPh }]}>
                {p.price}
                {p.unit ? (
                  <>
                    {' '}
                    <span style="font-family:var(--mono);font-size:13px;color:var(--muted);font-weight:400">{p.unit}</span>
                  </>
                ) : null}
              </div>
              <div class:list={['vpn-data-display', { 'vpn-data-placeholder': isPh }]}>{p.data}</div>
              <p style={`font-family:${bodyFont};font-size:13px;color:var(--muted);margin-bottom:28px`}>{p.desc}</p>
              <ul style="list-style:none;margin-bottom:32px;display:flex;flex-direction:column;gap:8px">
                {p.features.map((f) => (
                  <li style={`font-family:${bodyFont};font-size:13px;color:var(--white);display:flex;align-items:center;gap:8px`}>
                    <span style="color:#00C2FF;font-family:var(--mono)">—</span>
                    {f}
                  </li>
                ))}
                {p.missing.map((f) => (
                  <li style={`font-family:${bodyFont};font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px`}>
                    <span style="color:var(--muted);font-family:var(--mono)">—</span>
                    {f} ❌
                  </li>
                ))}
              </ul>
              {isPh ? (
                <div
                  style="display:block;text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.1em;padding:12px;border:1px dashed var(--border-strong);color:var(--muted);cursor:default;user-select:none"
                  aria-disabled="true"
                >
                  {vpn.pricing.placeholderCta}
                </div>
              ) : isContact ? (
                <a
                  href={contactHref}
                  target="_blank"
                  rel="noopener"
                  style="display:block;text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.1em;padding:12px;text-decoration:none;transition:.2s;background:rgba(0,194,255,.12);color:#00C2FF;border:1px solid rgba(0,194,255,.45)"
                >
                  {contactCta}
                </a>
              ) : (
                <a
                  href="https://t.me/OperonConnectBot"
                  target="_blank"
                  rel="noopener"
                  style={`display:block;text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.1em;padding:12px;text-decoration:none;transition:.2s;${p.featured ? 'background:#00C2FF;color:var(--navy);border:1px solid #00C2FF' : 'border:1px solid var(--border-strong);color:var(--muted)'}`}
                >
                  {vpn.pricing.cta}
                </a>
              )}
            </div>
          );
        })}
      </div>
      {vpn.pricing.comingSoon ? (
        <p
          style={`font-family:${bodyFont};font-size:14px;color:var(--muted);text-align:center;margin-top:28px;line-height:1.7;max-width:520px;margin-left:auto;margin-right:auto`}
        >
          {vpn.pricing.comingSoon}
        </p>
      ) : null}
    </div>
  </section>

  <!-- COMPATIBLE APPS -->
  <section class="section" id="apps" style="background:var(--navy2)" aria-labelledby="apps-title">
    <div class="container reveal">
      <span class="tag">{vpn.apps.tag}</span>
      <h2 class="section-title" id="apps-title">{vpn.apps.title}</h2>
      <p class="section-sub" style={`font-family:${bodyFont}`}>{vpn.apps.subtitle}</p>
      <div style="display:flex;flex-wrap:wrap;gap:16px">
        {vpn.apps.items.map((app) => (
          <div style="border:1px solid rgba(0,194,255,.15);padding:16px 20px;min-width:200px">
            <div style="font-family:var(--mono);font-size:13px;color:var(--white);margin-bottom:4px">{app.name}</div>
            <div style="font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:.04em">{app.platforms}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container reveal">
      <span class="tag">{vpn.faq.tag}</span>
      <h2 class="section-title" id="faq-title">{vpn.faq.title}</h2>
      <div style="max-width:800px;display:flex;flex-direction:column;gap:1px">
        {vpn.faq.items.map((item) => (
          <details class="vpn-faq-details" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <summary class="vpn-faq-summary" style={`font-family:${bodyFont}`}>
              <span itemprop="name">{item.question}</span>
              <span class="vpn-faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="vpn-faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p class="vpn-faq-answer-text" style={`font-family:${bodyFont}`} itemprop="text">
                {item.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    style="text-align:center;padding:100px 5%;position:relative;z-index:1;border-top:1px solid rgba(0,194,255,.08)"
    aria-label={vpn.cta.ariaLabel}
  >
    <h2 class="display-cta-wide">
      {vpn.cta.line1}<br /><span style="color:#00C2FF">{vpn.cta.line2}</span>
    </h2>
    <p style={`font-family:${bodyFont};font-size:16px;color:var(--muted);margin-bottom:40px;line-height:1.8`}>
      {vpn.cta.bodyLine1}
      <br />
      {vpn.cta.bodyLine2}
    </p>
    <a href="https://t.me/OperonConnectBot" class="btn-primary" style="font-size:14px;padding:16px 48px" target="_blank" rel="noopener">
      {vpn.cta.button}
    </a>
  </section>

  <Footer />
</div>
