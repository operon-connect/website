---
interface Props {
  /** Unique when multiple theme toggles exist on one page */
  toggleId?: string;
}

const { toggleId = 'theme-toggle' } = Astro.props;
---

<div
  class="inline-flex shrink-0 items-center rounded-lg border border-[color:var(--border-default)] bg-white/[0.04] p-0.5 dark:bg-black/[0.04]"
>
  <button
    type="button"
    id={toggleId}
    class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-[color:var(--muted)] transition-colors hover:bg-white/10 hover:text-[color:var(--white)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:color-mix(in_srgb,var(--brand-cyan)_45%,transparent)] dark:hover:bg-black/[0.08]"
    title="Toggle appearance"
    aria-label="Toggle day or night appearance"
  >
    <!-- Moon: shown on navy UI; tap → paper (light) -->
    <svg
      class="theme-icon-moon absolute h-[18px] w-[18px] transition-opacity duration-200"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <!-- Sun: shown on paper UI; tap → navy -->
    <svg
      class="theme-icon-sun absolute h-[18px] w-[18px] transition-opacity duration-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4.5"></circle>
      <line x1="12" y1="2" x2="12" y2="4"></line>
      <line x1="12" y1="20" x2="12" y2="22"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="2" y1="12" x2="4" y2="12"></line>
      <line x1="20" y1="12" x2="22" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </button>
</div>

<style>
  .theme-icon-sun {
    opacity: 0;
  }
  .theme-icon-moon {
    opacity: 1;
  }
  html.dark .theme-icon-sun {
    opacity: 1;
  }
  html.dark .theme-icon-moon {
    opacity: 0;
  }
</style>

<script is:inline define:vars={{ toggleId }}>
  function initTheme() {
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }

  initTheme();

  document.getElementById(toggleId)?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
