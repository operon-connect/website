---
import { getTranslations, getLocaleFromUrl, localePath } from '../i18n/index';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url.pathname);
const translations = getTranslations(locale);

const navLinks = [
  { href: localePath(locale, '/'), label: translations.nav.home },
  { href: localePath(locale, '/vpn'), label: translations.nav.vpn },
  { href: localePath(locale, '/about'), label: translations.nav.about },
];

const currentPath = Astro.url.pathname;
const isCurrentPath = (href: string) => {
  return currentPath === href || (href !== localePath(locale, '/') && currentPath.startsWith(href));
};

const linkBase =
  'rounded-full px-4 py-2 text-sm tracking-wide no-underline transition-colors max-md:rounded-none max-md:px-4 max-md:py-3.5 max-md:text-base';
const linkIdle =
  'text-[color:var(--nav-link)] transition-colors duration-200 hover:text-[color:var(--white)] hover:bg-white/[0.04] dark:hover:bg-black/[0.05] max-md:hover:bg-white/[0.04] max-md:dark:hover:bg-black/[0.05]';
const linkActive =
  'text-[color:var(--nav-active-fg)] bg-[color:var(--nav-active-bg)] border border-[color:var(--border-strong)] max-md:text-[color:var(--nav-active-fg)]';
---

<nav
  id="nav"
  class:list={[
    'group fixed left-0 right-0 top-0 z-50 w-full border-b border-[color:var(--border-default)] pt-[env(safe-area-inset-top,0px)]',
    'transition-[background-color,border-color,backdrop-filter] duration-300',
    'bg-[color:var(--navy)]/90 backdrop-blur-md',
    'data-[scrolled=true]:border-[color:var(--border-default)] data-[scrolled=true]:bg-[color:var(--frosted-nav)] data-[scrolled=true]:backdrop-blur-xl',
    'max-md:[&.nav-is-open]:border-[color:var(--border-strong)] max-md:[&.nav-is-open]:bg-[color:var(--navy2)] max-md:[&.nav-is-open]:backdrop-blur-xl',
  ]}
  data-scrolled="false"
  role="navigation"
  aria-label="Main navigation"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] grid-rows-[auto_auto] items-center gap-x-3 gap-y-0 px-4 py-3 md:flex md:flex-row md:items-center md:justify-between md:gap-8 md:px-6 md:py-3.5"
  >
    <a
      href={localePath(locale, '/')}
      class="nav-logo-lockup inline-flex min-w-0 max-w-full items-center gap-3 no-underline transition-none max-md:col-start-1 max-md:row-start-1"
      aria-label="Operon Connect home"
    >
      <img
        src="/operon-icon.svg"
        width="28"
        height="28"
        alt=""
        aria-hidden="true"
        class="no-my-override block h-7 w-7 shrink-0"
      />
      <span class="no-my-override nav-logo-wordmark text-[color:var(--white)]"
        ><span class="no-my-override nav-logo-track">OPERON</span><span
          class="no-my-override nav-logo-dot text-[color:var(--brand-cyan)]">.</span
        ><span class="no-my-override nav-logo-track">CONNECT</span></span
      >
    </a>

    <div
      class="nav-toolbar flex shrink-0 items-center justify-end gap-1.5 max-md:col-start-2 max-md:row-start-1 md:order-3 md:gap-2.5"
    >
      <LanguageSwitcher pathname={Astro.url.pathname} />
      <div class="max-md:hidden">
        <ThemeSwitcher toggleId="theme-toggle-toolbar" />
      </div>
      <button
        type="button"
        class="nav-menu-toggle inline-flex h-9 w-9 shrink-0 flex-col items-center justify-center gap-1.5 rounded-lg border border-[color:var(--border-default)] bg-white/[0.03] p-2 text-[color:var(--white)] transition-colors hover:border-[color:var(--border-strong)] hover:bg-white/5 dark:bg-black/[0.03] dark:hover:bg-black/[0.06] md:hidden"
        id="nav-menu-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <span class="nav-menu-bar" aria-hidden="true"></span>
        <span class="nav-menu-bar" aria-hidden="true"></span>
        <span class="nav-menu-bar" aria-hidden="true"></span>
      </button>
    </div>

    <ul
      class="nav-links m-0 list-none flex-col gap-0 border-t border-[color:var(--border-default)] bg-[color:var(--navy2)] max-md:col-span-2 max-md:row-start-2 max-md:px-0 md:order-2 md:flex md:flex-1 md:flex-row md:items-center md:justify-center md:gap-1 md:border-0 md:bg-transparent"
      id="primary-nav"
      role="list"
    >
      {
        navLinks.map((link, i) => (
          <li
            class:list={[
              'max-md:border-b max-md:border-[color:var(--border-default)]',
              i === navLinks.length - 1 && 'max-md:border-b-0',
            ]}
          >
            <a
              href={link.href}
              class:list={[linkBase, isCurrentPath(link.href) ? linkActive : linkIdle, 'block']}
            >
              {link.label}
            </a>
          </li>
        ))
      }

      <li
        class="flex items-center justify-between border-t border-[color:var(--border-default)] px-4 py-3 md:hidden"
      >
        <span class="text-sm text-[color:var(--nav-link)]">Theme</span>
        <ThemeSwitcher toggleId="theme-toggle-menu" />
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Fixed row + line box so icon and wordmark stay aligned when theme / color-scheme flips */
  .nav-logo-lockup {
    height: 28px;
  }
  .nav-logo-wordmark {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    line-height: 28px;
    letter-spacing: 0;
  }
  .nav-logo-track {
    letter-spacing: 0.12em;
  }
  .nav-logo-dot {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: 0;
  }
  @media (min-width: 640px) {
    .nav-logo-wordmark {
      font-size: 13px;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    #nav.nav-is-open .nav-links {
      display: flex;
    }
  }

  .nav-menu-toggle {
    display: none;
  }
  @media (max-width: 768px) {
    .nav-menu-toggle {
      display: inline-flex;
    }
  }

  .nav-menu-bar {
    display: block;
    height: 2px;
    width: 1.25rem;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  #nav.nav-is-open .nav-menu-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav.nav-is-open .nav-menu-bar:nth-child(2) {
    opacity: 0;
  }
  #nav.nav-is-open .nav-menu-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const toggle = document.getElementById('nav-menu-toggle');
  const menu = document.getElementById('primary-nav');

  function setOpen(open: boolean) {
    nav?.classList.toggle('nav-is-open', open);
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    setOpen(!nav?.classList.contains('nav-is-open'));
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
